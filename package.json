{
  "name": "solarb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=packages/watcher && npm run build --workspace=packages/detector",
    "watcher": "npm run start --workspace=packages/watcher",
    "detector": "npm run start --workspace=packages/detector"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1021.0",
    "@aws-sdk/client-sns": "^3.1021.0",
    "@aws-sdk/lib-dynamodb": "^3.1021.0",
    "dotenv": "^17.3.1"
  }
}
